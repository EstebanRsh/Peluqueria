# El navegador revalida JS y CSS en cada carga (usa ETag, no los vuelve a bajar si no cambiaron).
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.woff2$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
